        <mxCell id="8SxX1PG-NUlFmdvm8r1B-43" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontFamily=Helvetica;strokeWidth=2;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Specs:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font&gt;8 cores / 16 threads - AMD ryzen 7 5800x&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;32 Go RAM&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;4 To HDD&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;120 Go SSD&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;240 Go ssd (Main / Host)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;1 To external cold back-up for essential files&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;RX 7600 4Gb&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
